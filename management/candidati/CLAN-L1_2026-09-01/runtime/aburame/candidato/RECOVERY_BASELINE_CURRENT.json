        "signature": "applica_recupero(uuid)",
        "definition": "CREATE OR REPLACE FUNCTION public.applica_recupero(p_user uuid DEFAULT NULL::uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\ndeclare v_user uuid; c public.characters%rowtype; giorni numeric; add_v int; add_c int;\n        v_scontro interval;\nbegin\n  if public.is_staff() then\n    v_user := coalesce(p_user, auth.uid());\n  else\n    v_user := auth.uid();\n  end if;\n  if v_user is null then return; end if;\n  -- [V1.1 · decisione 9] Dentro uno scontro aperto non si recupera niente, e\n  -- soprattutto NON si tocca last_regen_at: il maturato resta lì e riparte a\n  -- scontro chiuso. Si riusa lo stesso predicato di combat_join e combat_open,\n  -- per non avere due definizioni di «essere in scontro».\n  if public._combat_impegnato(v_user) then return; end if;\n  select * into c from public.characters where user_id = v_user;\n  if c.id is null then return; end if;\n  -- [V1.1 · decisione 9] Il tempo passato a combattere non è tempo di riposo.\n  -- La finestra si taglia due volte: greatest(last_regen_at, joined_at) esclude\n  -- la parte già scontata in un recupero precedente, least(now(), closed_at)\n  -- protegge da un closed_at nel futuro, e greatest(interval '0', …) impedisce\n  -- che un intervallo invertito diventi un REGALO di tempo invece di uno\n  -- scomputo. Solo i combattenti: chi assiste non sta combattendo.\n  select coalesce(sum(greatest(\n           interval '0',\n           least(now(), s.closed_at) - greatest(coalesce(c.last_regen_at, now()), p.joined_at))),\n         interval '0')\n    into v_scontro\n    from public.combat_participants p\n    join public.combat_sessions s on s.id = p.session_id\n   where p.user_id = v_user\n     and p.ruolo   = 'combattente'\n     and s.state   = 'chiuso'\n     and s.closed_at is not null\n     and s.closed_at > coalesce(c.last_regen_at, now());\n  giorni := extract(epoch from (now() - coalesce(c.last_regen_at, now()) - coalesce(v_scontro, interval '0'))) / 86400.0;\n  if giorni <= 0 then return; end if;\n  add_v := floor( coalesce(c.vita_max,0) * giorni / 3.0 );\n  add_c := floor( coalesce(c.chakra_max,0) * giorni / 2.0 );\n  if add_v <= 0 and add_c <= 0 then return; end if;\n  perform set_config('app.allow_vita_delta','1', true);\n  perform set_config('app.allow_chakra_delta','1', true);\n  -- [GUARD-002-R2] aperto qui, subito prima dell'UPDATE...\n  perform set_config('app.allow_regen_at','1', true);\n  update public.characters\n     set vita = least(coalesce(vita_max,0), coalesce(vita,0) + greatest(add_v,0)),\n         chakra = least(coalesce(chakra_max,0), coalesce(chakra,0) + greatest(add_c,0)),\n         last_regen_at = now()\n   where user_id = v_user;\n  -- ...e richiuso subito dopo, prima di qualunque altra cosa.\n  perform set_config('app.allow_regen_at','', true);\nend; $function$\n"
      },
      {
        "acl": "{postgres=X/postgres,service_role=X/postgres}",
        "body_md5": "e7e536e6dc7371d24c1286e710efe2b5",
        "signature": "_combat_impegnato(uuid)",
        "definition": "CREATE OR REPLACE FUNCTION public._combat_impegnato(p_user uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select exists (select 1 from public.combat_participants p\n                   join public.combat_sessions s on s.id = p.session_id\n                  where p.user_id = p_user and s.state = 'aperto' and p.ruolo = 'combattente' and not p.fuori);\n$function$\n"
      }
